--- /dev/null
+++ b/lib/sbi/sbi_ecall_machine_oracle.c
@@ -0,0 +1,55 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Tiny educational SBI extension for reading selected M-mode CSRs.
+ */
+
+#include <sbi/riscv_asm.h>
+#include <sbi/sbi_ecall.h>
+#include <sbi/sbi_ecall_interface.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_trap.h>
+
+static int sbi_ecall_machine_oracle_handler(unsigned long extid,
+					    unsigned long funcid,
+					    struct sbi_trap_regs *regs,
+					    struct sbi_ecall_return *out)
+{
+	int ret = 0;
+
+	switch (funcid) {
+	case SBI_EXT_MACHINE_ORACLE_READ_MVENDORID:
+		out->value = csr_read(CSR_MVENDORID);
+		break;
+	case SBI_EXT_MACHINE_ORACLE_READ_MARCHID:
+		out->value = csr_read(CSR_MARCHID);
+		break;
+	case SBI_EXT_MACHINE_ORACLE_READ_MIMPID:
+		out->value = csr_read(CSR_MIMPID);
+		break;
+	case SBI_EXT_MACHINE_ORACLE_READ_MHARTID:
+		out->value = csr_read(CSR_MHARTID);
+		break;
+	default:
+		ret = SBI_ENOTSUPP;
+		break;
+	}
+
+	return ret;
+}
+
+struct sbi_ecall_extension ecall_machine_oracle;
+
+static int sbi_ecall_machine_oracle_register_extensions(void)
+{
+	return sbi_ecall_register_extension(&ecall_machine_oracle);
+}
+
+struct sbi_ecall_extension ecall_machine_oracle = {
+	.name			= "moracle",
+	.extid_start		= SBI_EXT_MACHINE_ORACLE,
+	.extid_end		= SBI_EXT_MACHINE_ORACLE,
+	.experimental		= true,
+	.register_extensions	= sbi_ecall_machine_oracle_register_extensions,
+	.handle			= sbi_ecall_machine_oracle_handler,
+};
