+SYSCALL_DEFINE0(machine_oracle)
+{
+#ifdef CONFIG_RISCV_SBI
+	struct sbiret ret;
+
+	ret = sbi_ecall(SBI_EXT_MACHINE_ORACLE,
+			SBI_EXT_MACHINE_ORACLE_READ_MVENDORID,
+			0, 0, 0, 0, 0, 0);
+	if (ret.error)
+		return sbi_err_map_linux_errno(ret.error);
